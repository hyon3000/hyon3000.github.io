query_result_depth_bound_bias = 0


[database.libfile]

# Mapping of marks in library file
# Libæ–‡ä»¶æ ‡è®°æ˜ å°„
black_win_mark = "a"
white_win_mark = "c"
black_lose_mark = "c"
