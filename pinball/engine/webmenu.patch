--- a/SpaceCadetPinball/winmain.cpp
+++ b/SpaceCadetPinball/winmain.cpp
@@ -341,6 +341,8 @@ int winmain::WinMain(LPCSTR lpCmdLine)
 	return return_value;
 }
 
+static bool g_hideMenu = true;   // the web page has its own menu
+
 void winmain::RenderUi()
 {
 	// No demo window in release to save space
@@ -349,7 +351,7 @@ void winmain::RenderUi()
 		ImGui::ShowDemoWindow(&ShowImGuiDemo);
 #endif
 
-	if (ImGui::BeginMainMenuBar())
+	if (!g_hideMenu && ImGui::BeginMainMenuBar())
 	{
 		if (ImGui::BeginMenu("Game"))
 		{
@@ -834,3 +836,54 @@ void winmain::UpdateFrameRate()
 	UpdateToFrameRatio = static_cast<double>(ups) / fps;
 	TargetFrameTime = DurationMs(1000.0 / ups);
 }
+
+void winmain::WebCommand(int id)
+{
+	switch (id)
+	{
+	case 1: new_game(); break;
+	case 2: if (LaunchBallEnabled) { end_pause(); pb::launch_ball(); } break;
+	case 3: pause(); break;
+	case 4: if (HighScoresEnabled) { if (!single_step) pause(); pb::high_scores(); } break;
+	case 5: end_pause(); pb::toggle_demo(); break;
+	case 6: options::toggle(Menu1::OnePlayer); new_game(); break;
+	case 7: options::toggle(Menu1::TwoPlayers); new_game(); break;
+	case 8: options::toggle(Menu1::ThreePlayers); new_game(); break;
+	case 9: options::toggle(Menu1::FourPlayers); new_game(); break;
+	case 10: options::toggle(Menu1::Sounds); break;
+	case 11: options::toggle(Menu1::Music); break;
+	case 12: if (!single_step) pause(); options::keyboard(); break;
+	case 13: options::toggle(Menu1::MaximumResolution); break;
+	case 15: options::toggle(Menu1::WindowUniformScale); break;
+	case 16: options::toggle(Menu1::WindowLinearFilter); break;
+	case 17: if (!single_step) pause(); ShowAboutDialog = true; break;
+	case 18: options::Options.UpdatesPerSecond = options::DefUps; options::Options.FramesPerSecond = options::DefFps; UpdateFrameRate(); break;
+	case 19: g_hideMenu = !g_hideMenu; break;
+	default:
+		if (id >= 20 && id < 30) options::toggle(static_cast<Menu1>(static_cast<int>(Menu1::R640x480) + (id - 20)));
+	}
+}
+
+int winmain::WebState(int id)
+{
+	switch (id)
+	{
+	case 1: return options::Options.Players;
+	case 2: return options::Options.Sounds ? 1 : 0;
+	case 3: return options::Options.Music ? 1 : 0;
+	case 4: return options::Options.UniformScaling ? 1 : 0;
+	case 5: return options::Options.LinearFiltering ? 1 : 0;
+	case 6: return options::Options.Resolution;
+	case 7: return DemoActive ? 1 : 0;
+	case 8: return LaunchBallEnabled ? 1 : 0;
+	case 9: return HighScoresEnabled ? 1 : 0;
+	case 10: return fullscrn::GetMaxResolution();
+	}
+	return 0;
+}
+
+extern "C"
+{
+EMSCRIPTEN_KEEPALIVE void pbweb_cmd(int id) { winmain::WebCommand(id); }
+EMSCRIPTEN_KEEPALIVE int pbweb_get(int id) { return winmain::WebState(id); }
+}
